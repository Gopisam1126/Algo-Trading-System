# ===========================================================================
# Copy to .env and fill in.  NEVER commit .env — it is gitignored.
#
# In production these come from the secrets provider (Vault or SOPS+age),
# not from a file.  .env is for local development only.
# See LOW_LEVEL_ARCHITECTURE.md §10.4.
# ===========================================================================

# --- Runtime ---
ALGOTRADER_ENV=development          # development | paper | production
ALGOTRADER_CONFIG=config/system.yaml
LOG_LEVEL=INFO

# --- Secrets provider ---
SECRETS_PROVIDER=env                # env | sops | vault
# VAULT_ADDR=https://vault.internal:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# SOPS_AGE_KEY_FILE=/etc/algotrader/age.key

# --- Broker: Zerodha Kite Connect (primary) ---
# Auth is a REDIRECT flow, not a direct login:
#   1. Send the user to https://kite.zerodha.com/connect/login?api_key=...&v=3
#   2. They authenticate (with 2FA)
#   3. Zerodha redirects to KITE_REDIRECT_URI carrying a request_token
#   4. Exchange request_token + KITE_API_SECRET for an access_token
#   5. The access_token expires daily and must be re-established before
#      the next pre-open (SEBI requires this anyway)
#
# KITE_ACCESS_TOKEN is written by the daily auth step; do not set it by hand.
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_REDIRECT_URI=http://127.0.0.1:8080/auth/kite/callback
KITE_ACCESS_TOKEN=

# --- Broker: Fyers (fallback / data redundancy) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Datastores -------------------------------------------------------------
#
# HOW THIS WORKS — one credential, one source.
#
# The connection STRUCTURE (host, port, database name, user, pool sizes) lives
# in config/system.yaml, which is version controlled.  The PASSWORD lives here
# and nowhere else.  The two are joined at runtime.
#
# The three POSTGRES_* values below are read by BOTH docker-compose (to
# initialise the database on first run) and the application (to connect to it),
# so they cannot disagree.  docker-compose FAILS TO START if POSTGRES_PASSWORD
# is unset — that is deliberate, an empty database password is not a default
# worth having.
#
# Generate a strong one, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_DB=algotrader
POSTGRES_USER=algotrader
POSTGRES_PASSWORD=

# Optional Redis password.  Leave blank for local development: the compose
# Redis is on an `internal: true` network with no published port, so it is not
# reachable from outside the host.  Set it if you expose Redis for any reason.
REDIS_PASSWORD=

# --- Connection overrides (normally leave these COMMENTED OUT) ---
#
# If set, each of these wins ENTIRELY and the matching section of
# config/system.yaml is ignored — including the host, port and database name.
# `make doctor` reports which source is actually in effect, so an override can
# never be silently in force.
#
# You do NOT need these for local development.  They exist because:
#   - ops/docker-compose.yml injects them so containers reach `timescaledb`
#     and `redis` by service name instead of `localhost`
#   - the integration test fixtures set them to point at ephemeral containers
#   - they let you point at a managed database without editing system.yaml
#
# DATABASE_URL=postgresql+psycopg://algotrader:PASSWORD@localhost:5432/algotrader
# REDIS_URL=redis://localhost:6379/0

# --- Observability ---
# Grafana's admin password.  Like POSTGRES_PASSWORD, docker-compose FAILS TO
# START if this is unset — Grafana defaults to admin/admin otherwise, and the
# dashboards expose position and P&L data.
GRAFANA_PASSWORD=

# --- Notifications (SINGLE RECIPIENT — see MVP_UI_AND_LEGAL.md §2.3) ---
# Configuring more than one recipient will refuse to start.  This is a
# regulatory control, not a preference: broadcasting signals can trigger
# SEBI Research Analyst obligations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News / macro data ---
NEWS_API_KEY=

# --- Compliance ---
# Must match the machine's actual egress IP and be whitelisted with the broker.
# Startup fails if the real egress IP differs.  SEBI requirement.
EXPECTED_EGRESS_IP=
SEBI_ALGO_ID=
