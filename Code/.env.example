# ===========================================================================
# Copy to .env and fill in.  NEVER commit .env — it is gitignored.
#
# In production these come from the secrets provider (Vault or SOPS+age),
# not from a file.  .env is for local development only.
# See LOW_LEVEL_ARCHITECTURE.md §10.4.
# ===========================================================================

# --- Runtime ---
ALGOTRADER_ENV=development          # development | paper | production
ALGOTRADER_CONFIG=config/system.yaml
LOG_LEVEL=INFO

# --- Secrets provider ---
SECRETS_PROVIDER=env                # env | sops | vault
# VAULT_ADDR=https://vault.internal:8200
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=
# SOPS_AGE_KEY_FILE=/etc/algotrader/age.key

# --- Broker: Zerodha Kite Connect (primary) ---
# Auth is a REDIRECT flow, not a direct login:
#   1. Send the user to https://kite.zerodha.com/connect/login?api_key=...&v=3
#   2. They authenticate (with 2FA)
#   3. Zerodha redirects to KITE_REDIRECT_URI carrying a request_token
#   4. Exchange request_token + KITE_API_SECRET for an access_token
#   5. The access_token expires daily and must be re-established before
#      the next pre-open (SEBI requires this anyway)
#
# KITE_ACCESS_TOKEN is written by the daily auth step; do not set it by hand.
KITE_API_KEY=
KITE_API_SECRET=
KITE_USER_ID=
KITE_REDIRECT_URI=http://127.0.0.1:8080/auth/kite/callback
KITE_ACCESS_TOKEN=

# --- Broker: Fyers (fallback / data redundancy) ---
FYERS_APP_ID=
FYERS_SECRET_KEY=
FYERS_REDIRECT_URI=

# --- Anthropic ---
ANTHROPIC_API_KEY=

# --- Datastores ---
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql+psycopg://algotrader:changeme@localhost:5432/algotrader

# --- Notifications (SINGLE RECIPIENT — see MVP_UI_AND_LEGAL.md §2.3) ---
# Configuring more than one recipient will refuse to start.  This is a
# regulatory control, not a preference: broadcasting signals can trigger
# SEBI Research Analyst obligations.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- News / macro data ---
NEWS_API_KEY=

# --- Compliance ---
# Must match the machine's actual egress IP and be whitelisted with the broker.
# Startup fails if the real egress IP differs.  SEBI requirement.
EXPECTED_EGRESS_IP=
SEBI_ALGO_ID=
