# ===========================================================================
# SECRETS — nothing in this block may ever be committed.
# Enforced additionally by the gitleaks pre-commit hook.
# ===========================================================================
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets/
config/secrets.*
*.sops.yaml
!*.sops.example.yaml
age.key
.age/

# Broker / API credential dumps
**/credentials*.json
**/token*.json
**/session*.json

# ===========================================================================
# Data — market data and trade records stay local
# ===========================================================================
# Everything the running system writes under data/ is ignored by DEFAULT, then
# the two placeholder directories are re-admitted. Deny-by-default matters here:
# the previous rules listed `data/historical/*` and `data/archive/*` only, so
# the audit disk buffer (E01-S05) — JSONL holding decision payloads, prices,
# positions, rejection reasons and AI rationale, written whenever the database
# is unavailable — was NOT covered, and a single outage would have put trade
# decisions into git history.
#
# Order is load-bearing. Git cannot re-include a file inside an excluded
# DIRECTORY, so each directory must be un-excluded before its contents are
# re-excluded.
data/*
!data/.gitkeep
!data/historical/
!data/archive/
data/historical/*
data/archive/*
!data/historical/.gitkeep
!data/archive/.gitkeep

*.parquet
*.duckdb
*.sqlite
*.db
*.jsonl

# Backtest and validation artefacts
backtest_results/
validation_reports/

# ===========================================================================
# Python
# ===========================================================================
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
htmlcov/
.coverage
.coverage.*
dist/
build/

# ===========================================================================
# Ops
# ===========================================================================
*.log
logs/
docker-compose.override.yml
.DS_Store
Thumbs.db
.idea/
.vscode/
!.vscode/extensions.json
